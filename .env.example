# =========================
# Django
# =========================

DJANGO_ENV=development
DJANGO_SECRET_KEY=replace-with-generated-secret-key
DJANGO_DEBUG=True

DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000


# =========================
# PostgreSQL
# =========================

DB_NAME=minobr
DB_USER=minobr_app
DB_PASSWORD=replace-with-database-password
DB_HOST=localhost
DB_PORT=5432


# =========================
# Security / proxy
# =========================

DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=0

# Set True only behind a private, configured reverse proxy in production.
DJANGO_TRUST_PROXY=False
DJANGO_TRUSTED_PROXY_IPS=
# DJANGO_MEDIA_ROOT=/srv/minobr/private-media
